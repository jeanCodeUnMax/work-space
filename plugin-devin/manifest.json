  "permissions": {
    "ntfsElevation": {
      "required": true,
      "scope": [
        "read"
      ],
      "paths": [
        "<workspace>"
      ],
      "justification": "Lecture seule index NTFS $MFT via hphe-mcp.exe; aucune écriture directe"
    },
    "consentRequired": true
  },
  "mcpProxy": {
    "exe": "hphe-mcp.exe",
    "pathEnv": "HPHE_MCP_PATH",
    "args": [],
    "fallback": "<workspace>/hphe/target/release/hphe-mcp.exe"
  },
  "policy": {
    "writeToolsRequireConfirmation": true,
    "writeTools": [
      "mcp_fs_write_file",
      "mcp_fs_create_directory",
      "mcp_fs_move",
      "mcp_fs_delete",
      "mcp_fs_edit_file",
      "mcp_create_task",
      "mcp_update_task",
      "mcp_delete_task",
      "mcp_update_agent",
      "mcp_memory_write",
      "mcp_memory_update",
      "mcp_hephaistos_update"
    ]
  }
