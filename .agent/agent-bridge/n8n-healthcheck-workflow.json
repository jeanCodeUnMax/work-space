    {
      "parameters": {
        "jsCode": "const names = ['Probe Index','Probe Agents','Probe Tasks','Probe Sessions','Probe Roster','Probe Bridge','Probe Memory','Probe Vec','Probe Content','Probe REST','Probe n8n'];\nconst critical = new Set(['Probe Index','Probe Agents','Probe Tasks','Probe Sessions','Probe Roster']);\nconst probes = {};\nfor (const n of names) {\n  let j;\n  try { j = $(n).first().json; } catch (e) { j = { error: 'no data' }; }\n  let ok = false, detail = null;\n  if (j && j.result) {\n    const txt = j.result.content && j.result.content[0] && j.result.content[0].text;\n    let parsed; try { parsed = JSON.parse(txt); } catch { parsed = txt; }\n    ok = !j.result.isError;\n    detail = (typeof parsed === 'object') ? parsed : String(parsed || '').slice(0, 200);\n  } else if (j && (j.error || j.errorMessage || j.name === 'NodeApiError')) {\n    ok = false;\n    detail = String((j.error && j.error.message) || j.errorMessage || j.message || j.error || 'err').slice(0, 200);\n  } else if (j && Object.keys(j).length) {\n    ok = true;\n    detail = j;\n  } else {\n    detail = 'empty';\n  }\n  probes[n] = { critical: critical.has(n), ok, detail };\n}\nconst failedCritical = Object.entries(probes).filter(([, p]) => p.critical && !p.ok).map(([k]) => k);\nconst failedWarn = Object.entries(probes).filter(([, p]) => !p.critical && !p.ok).map(([k]) => k);\nconst verdict = failedCritical.length ? 'down' : (failedWarn.length ? 'degraded' : 'ok');\nreturn [{ json: { ts: new Date().toISOString(), source: 'n8n-hphe-healthcheck', verdict, failedCritical, failedWarn, probes } }];"
      },
      "id": "6e1e9397-838e-4b4c-b8d8-d1c2fb18fcff",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        656
      ]
    },
    {
