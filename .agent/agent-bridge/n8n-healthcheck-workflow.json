        "method": "POST",
        "url": "http://127.0.0.1:7478/tools/call",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"name\":\"hephaistos-everything-search__memory_read\",\"arguments\":{\"projectId\":\"hephaistos2-kit\",\"key\":\"diag/n8n-latest\"}}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "48a925c5-7392-48c9-bc8b-8041044a3ead",
      "name": "Read Prev",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
