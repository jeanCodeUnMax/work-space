    {
      "parameters": {
        "jsCode": "const report = $('Verdict').first().json;\nconst manual = (()=>{try{$('Webhook Manuel').first();return true}catch(e){return false}})();\nconst groups = {\n  'Sonde-MCP-Core': ['Probe Index'],\n  'Sonde-Orchestrateur': ['Probe Agents','Probe Tasks'],\n  'Sonde-Roster-Chats': ['Probe Sessions','Probe Roster'],\n  'Sonde-Bus-Flux': ['Probe Bridge'],\n  'Sonde-Memoire-Recherche': ['Probe Memory','Probe Vec','Probe Content'],\n  'Sonde-n8n-Gateways': ['Probe REST','Probe n8n']\n};\nconst ws = 'C:/data-sys/hephaistos2-kit';\nconst cards = {\n  'Sonde-MCP-Core': ['omniroute','chat-mvmw59wa'],\n  'Sonde-Orchestrateur': ['nim','chat-mvmtldvy'],\n  'Sonde-Roster-Chats': ['nim2','chat-mvpfinfra'],\n  'Sonde-Bus-Flux': ['nim2','chat-mvfj8b4m'],\n  'Sonde-Memoire-Recherche': ['omniroute','chat-mvmw5chd'],\n  'Sonde-n8n-Gateways': ['openrouter','chat-2dca1141-dfd6-4ae2-863f-72fea217eee3'],\n  'Sentinelle-Verdict': ['omniroute','chat-mvfqytbz']\n};\nconst items = [];\nconst short = d => String(typeof d==='object'?JSON.stringify(d):d).slice(0,240);\n// Fanout cartes : toujours si run manuel, seulement si incident en schedule\nif (manual || report.verdict !== 'ok') {\n  for (const [role, names] of Object.entries(groups)) {\n    const lines = names.map(n => { const p=(report.probes||{})[n]||{}; return n+' : '+(p.ok?'OK':'FAIL')+' — '+short(p.detail); });\n    items.push({ json: { workspaceRoot: ws, sessionId: cards[role][1], providerId: cards[role][0], timeoutSec: 25, text: '[SONDE n8n '+report.ts+']\\n'+lines.join('\\n') } });\n  }\n  const fails = [...(report.failedCritical||[]),...(report.failedWarn||[])];\n  items.push({ json: { workspaceRoot: ws, sessionId: cards['Sentinelle-Verdict'][1], providerId: cards['Sentinelle-Verdict'][0], timeoutSec: 25, text: '[VERDICT n8n '+report.ts+'] '+report.verdict.toUpperCase()+(fails.length?' | echecs: '+fails.join(', '):'')+' | transition prev: '+(report.previousVerdict||'aucun') } });\n}\n// Reponse finale toujours vers Devin\nitems.push({ json: { workspaceRoot: ws, sessionId: 'acp/devin-cli/gamy-freighter', providerId: 'devin-cli', timeoutSec: 30, text: 'HEALTHCHECK n8n — verdict: '+report.verdict.toUpperCase()+' | '+((report.failedCritical||[]).concat(report.failedWarn||[])).join(', ')+' | detail: '+short(report.alertCtx||report.verdict) } });\nreturn items;"
      },
