    },
    {
      "parameters": {
        "jsCode": "const report = $('Aggregate').first().json;\nlet prev = null;\ntry {\n  const t = $('Read Prev').first().json;\n  const txt = t.result && t.result.content && t.result.content[0] && t.result.content[0].text;\n  if (txt) { const m = JSON.parse(txt); if (m.memory && m.memory.content) prev = JSON.parse(m.memory.content).verdict || null; }\n} catch (e) {}\nreport.previousVerdict = prev;\nconst fc = report.failedCritical || [], fw = report.failedWarn || [];\nreport.alertCtx = report.verdict + ' | critical: ' + (fc.join(', ') || '-') + ' | warn: ' + (fw.join(', ') || '-');\nreport.newAlert = report.verdict !== 'ok' && prev !== report.verdict;\nreturn [{ json: report }];"
      },
