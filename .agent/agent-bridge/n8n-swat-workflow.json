  "nodes": [
    { "id": "trigger", "name": "Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 100], "parameters": {} },
    { "id": "demo", "name": "Exemple manuel uniquement", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [220, 100], "notesInFlow": true, "notes": "Exemple de test. Les appels Webhook et sous-workflow fournissent leur propre mission sans passer ici.", "parameters": { "jsCode": "return [{json: {missionId: 'demo-' + $execution.id, swatId: 'schema-swat-n8n', objective: 'Test de liaison uniquement : chacun confirme son role et la reception du contexte amont, en une phrase. Aucun outil, ecriture, import ou appel externe.', inputs: {}, constraints: ['Ne rien modifier', 'Repondre uniquement pour son propre role'], expectedDeliverable: 'Trois reponses correlees et un statut final.'}}];" } },
    { "id": "webhook", "name": "Mission externe authentifiee", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "webhookId": "hphe-swat-missions", "position": [0, 340], "parameters": { "httpMethod": "POST", "path": "hephaistos-swat-missions", "authentication": "headerAuth", "responseMode": "lastNode", "responseData": "firstEntryJson", "options": {} }, "credentials": { "httpHeaderAuth": { "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce", "name": "Hephaistos Bridge" } } },
    { "id": "subworkflow", "name": "Mission depuis autre workflow", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.1, "position": [0, 560], "parameters": { "inputSource": "passthrough" } },
    { "id": "mission", "name": "Contrat de mission dynamique", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [450, 300], "parameters": { "jsCode": "const b = $json.body ?? $json;\nif (typeof b.missionId !== 'string' || !/^[a-zA-Z0-9_-]{1,100}$/.test(b.missionId)) throw new Error('missionId requis, 1-100 caracteres alphanumeriques, _ ou -');\nif (typeof (b.swatId || b.schemaId) !== 'string' || typeof b.objective !== 'string' || !b.objective.trim()) throw new Error('swatId et objective requis');\nreturn [{json: {missionId: b.missionId, swatId: b.swatId || b.schemaId, objective: b.objective, inputs: b.inputs ?? {}, constraints: b.constraints ?? [], expectedDeliverable: b.expectedDeliverable ?? 'Synthese avec preuves et limites.'}}];" } },
    { "id": "entry", "name": "Attribuer mission au SWAT actif", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [700, 300], "notesInFlow": true, "notes": "Lit le schema actif de extension. missionId idempotent. Aucun choix implicite ni remplacement de session.", "parameters": { "method": "POST", "url": "http://127.0.0.1:7478/swat/start", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ $json }}", "options": { "timeout": 30000 } }, "credentials": { "httpHeaderAuth": { "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce", "name": "Hephaistos Bridge" } } },
    { "id": "step", "name": "Executer prochain agent du graphe", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [960, 300], "notesInFlow": true, "notes": "Roles, missions, sessions et dependances lus dans le schema, pas dans le workflow. Attend end_turn. Arret sur echec ou changement de graphe.", "parameters": { "method": "POST", "url": "http://127.0.0.1:7478/swat/next", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { runId: $json.runId } }}", "options": { "timeout": 360000 } }, "credentials": { "httpHeaderAuth": { "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce", "name": "Hephaistos Bridge" } } },
    { "id": "done", "name": "SWAT termine", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1220, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "done-condition", "leftValue": "={{ $json.done }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" }, "options": {} } },
    { "id": "result", "name": "Resultat de mission", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1480, 220], "parameters": { "url": "={{ 'http://127.0.0.1:7478/missions/' + encodeURIComponent($json.missionId) }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 15000 } }, "credentials": { "httpHeaderAuth": { "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce", "name": "Hephaistos Bridge" } } }
  ],
