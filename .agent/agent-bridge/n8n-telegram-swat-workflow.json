      ]
    },
    {
      "parameters": {
        "jsCode": "const v = $('Verdict et texte final').item.json;\nreturn [{ json: { ok: false, sent: false, chat: v.chat, state: v.state, reason: 'Verdict NO-GO ou texte vide', verdict: v.verdict } }];"
      },
      "id": "n10",
      "name": "Rapport refus",
