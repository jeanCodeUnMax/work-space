  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hephaistos-telegram",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "id": "n1",
      "name": "Demande message authentifiee",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -800,
        0
      ],
      "webhookId": "hephaistos-telegram",
      "credentials": {
        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst instruction = String(b.instruction ?? b.text ?? b.objective ?? '').trim();\nif (!instruction) throw new Error('instruction (ou text/objective) requis');\nconst missionId = typeof b.missionId === 'string' && /^[a-zA-Z0-9_-]{1,100}$/.test(b.missionId) ? b.missionId : 'telegram-' + Date.now().toString(36);\nconst chat = String(b.chat ?? 'caverne');\nreturn [{ json: { chat, contract: { missionId, swatId: 'schema-mvr09niq-8yor8', objective: 'Rediger et valider un message Telegram pour le chat ' + chat + ' selon l instruction fournie.', inputs: { instruction, chat }, constraints: ['Texte final <= 4096 caracteres', 'Aucun secret ni donnee personnelle', 'Format Telegram (texte ou Markdown)'], expectedDeliverable: 'GO + texte final du message Telegram dans la reponse du Relecteur-Modo.' } } }];"
      },
      "id": "n2",
      "name": "Contrat message telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -580,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:7478/swat/bind",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: \"swat-telegram\" }) }}",
        "options": {
          "timeout": 40000
        }
      },
      "id": "n3",
      "name": "Attribuer Bleubites du pool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "bind-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
