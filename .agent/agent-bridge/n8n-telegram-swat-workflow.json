    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/hephaistos-swat-missions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Contrat message telegram').item.json.contract) }}",
        "options": {
          "timeout": 390000
        }
      },
      "id": "n5",
      "name": "Rediger via SWAT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nconst chat = $('Contrat message telegram').item.json.chat;\nconst steps = r.steps || (r.result && r.result.steps) || [];\nconst last = steps[steps.length - 1];\nconst reply = String(last?.reply ?? '').trim();\nconst nogo = /^NO-GO\\b/i.test(reply);\nconst go = /^GO\\b/i.test(reply) && !nogo;\nconst text = reply.replace(/^GO\\s*[:\\-]?\\s*/i, '').trim();\nif (!go || !text) return [{ json: { send: false, chat, state: r.state, verdict: reply.slice(0, 500) } }];\nreturn [{ json: { send: true, chat, text, state: r.state } }];"
      },
      "id": "n6",
      "name": "Verdict et texte final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
