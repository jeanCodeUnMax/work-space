      "typeVersion": 2.2,
      "position": [
        480,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/swat-telegram-hub",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'send', chat: $json.chat, text: $json.text }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n8",
      "name": "Envoyer via Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -160
      ],
