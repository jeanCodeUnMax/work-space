        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, sent: true, chat: $('GO envoi ?').item.json.chat, telegram: $json } }];"
      },
      "id": "n9",
      "name": "Rapport envoi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
