      "id": "m2",
      "name": "Attacher resultat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const m = $json;\nif (m.mode === 'hub' && m.hub) { return [{ json: { mode: 'send', chat: m.chat, messageId: m.messageId, thread: m.thread, text: String(m.hub.stdout || JSON.stringify(m.hub)).slice(0, 1500) } }]; }\nreturn [{ json: m }];"
      },
