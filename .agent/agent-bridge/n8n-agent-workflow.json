              "description": "Identifiant unique de la mission, ex. action-2026-001",
              "type": "string"
            },
            {
              "name": "swatId",
              "description": "schemaId du SWAT actif (champ activeSchemaId de catalogue_swats)",
              "type": "string"
            },
            {
              "name": "objective",
