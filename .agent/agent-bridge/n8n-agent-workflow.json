      "parameters": {
        "toolDescription": "ACTION : lance une mission SWAT complete de bout en bout (workflow hephaistos-swat-missions : demarrage + execution de chaque agent du graphe + rapport final). Utiliser UNIQUEMENT sur demande explicite ; recuperer le swatId actif via catalogue_swats (activeSchemaId) ; missionId unique et stable.",
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/hephaistos-swat-missions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "parametersBody": {
          "values": [
