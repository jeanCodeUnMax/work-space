    },
    {
      "id": "tool-mission",
      "name": "statut_mission",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        280,
        640
      ],
      "parameters": {
        "toolDescription": "Retourne l'etat d'une mission SWAT par son missionId : running, completed, failed et les etapes terminees. Necessite le missionId exact fourni par l'utilisateur ; s'il n'en donne pas, demande-le au lieu d'appeler cet outil.",
        "method": "GET",
        "url": "http://127.0.0.1:7478/missions/{missionId}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "optimizeResponse": true,
        "placeholderDefinitions": {
          "values": [
            {
              "name": "missionId",
              "description": "Identifiant exact de la mission a consulter",
              "type": "string"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "id": "tool-diag",
      "name": "lancer_diagnostic",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        500,
        560
      ],
      "parameters": {
        "toolDescription": "Lance le diagnostic complet de l'architecture Hephaistos2-Kit (SWAT diagnostic : Runtime-Comms, Roster, Architecture, Synthese). Retourne le verdict et les checks. Peut prendre plusieurs minutes. Prerequis : le schema actif dans l'extension doit etre 'swat-diagnostic-hephaistos' ; si l'appel echoue avec l'erreur sur le schema actif, demande a l'utilisateur de le selectionner d'abord.",
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/hephaistos-diagnostic",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "optimizeResponse": true
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4ae21b16-46a3-40d9-9635-28717f0e0fce",
          "name": "Hephaistos Bridge"
        }
      }
    },
    {
      "id": "tool-launch",
