    {
      "parameters": {
        "jsCode": "// Choisit la fenêtre focalisée (sinon la première) et prépare le POST /ask\nconst sessions = $input.first().json.sessions || [];\nconst target = sessions.find(s => s.focused) || sessions[0];\nif (!target) throw new Error('Aucune fenêtre ACP ouverte');\nreturn [{\n  json: {\n    providerId: target.providerId,\n    sessionId: target.sessionId,\n    text: 'Réponds en une phrase : confirme que tu reçois ce message depuis n8n.',\n    timeoutSec: 300\n  }\n}];"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
