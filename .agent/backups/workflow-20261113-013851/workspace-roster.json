    "nodes": [
      {
        "sessionId": "acp/devin-cli/ionian-helicopter",
        "role": "Grand-Chef",
        "task": "ROLE: Grand Chef de la Tribu. Tu recois la problematique soumise par Devin (champ question du noeud ou dernier message de ta session). Tu la reformules en prompt neutre, puis tu passes le calumet a chaque membre dans l'ordre fixe : Premiers-Principes, Expansionniste, Executeur, Outsider, Contrariant, Empirique. Chacun entend les paroles deja prononcees avant de parler. Tu presides : tu coupes les digressions, tu fais respecter l'ordre. Quand le calumet te revient, tu rends le verdict en 5 sections : Consensus, Desaccords, Angles morts, Recommandation, Premier pas concret.",
        "skills": [
          "orchestrator",
          "llm-council"
        ],
        "mcps": [],
        "title": "daring-agent",
        "position": {
          "x": 0,
          "y": 0
        },
        "provider": "devin-cli",
        "cardKind": "devin"
      },
      {
        "sessionId": "chat-mvmw59wa",
        "role": "Premiers-Principes",
        "task": "ROLE: Le calumet t'arrive du Grand Chef — tu parles le premier, personne n'a encore pris la parole. Quelle que soit la problematique soumise, tu ignores la question de surface : quel probleme resout-on vraiment ? Tu deconstruis les hypotheses implicites et reconstruis le probleme depuis le sol.",
        "skills": [
          "architecture",
          "llm-council"
        ],
