# Configuration de la passerelle IA unifiee n8n (aucun secret reel ici)
N8N_AI_GATEWAY_PORT=11435
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optionnel : pour Ollama Cloud direct (https://ollama.com/v1)
OLLAMA_CLOUD_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=<YOUR_OLLAMA_CLOUD_API_KEY>

# Optionnel : proxy auth n8n (dans votre .env local, jamais versionne)
N8N_TARGET=http://127.0.0.1:5678
N8N_PROXY_PORT=5680
N8N_EMAIL=<YOUR_N8N_EMAIL>
N8N_PASSWORD=<YOUR_N8N_PASSWORD>
N8N_API_KEY=<YOUR_N8N_API_KEY>
