{
	"name": "orchestrator-monitor",
	"displayName": "Hephaistos Orchestrator Monitor",
	"description": "Extension du Hephaistos-Kit : supervision en temps réel de l'orchestrateur multi-agents du kit (tâches, agents, modèles, providers) via bridge WebSocket sur orchestrator.db",
	"version": "0.0.33",
	"icon": "resources/hephaistos-icon.png",
	"publisher": "hephaistos",
	"repository": {
		"type": "git",
		"url": "https://github.com/art-qalam-fr/Hephaistos-Kit.git",
		"directory": "extensions/orchestrator-monitor"
	},
	"homepage": "https://github.com/art-qalam-fr/Hephaistos-Kit",
	"bugs": {
		"url": "https://github.com/art-qalam-fr/Hephaistos-Kit/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "orchestratorMonitor",
					"title": "Hephaistos",
					"icon": "resources/hephaistos-icon.png"
				}
			]
		},
		"views": {
			"orchestratorMonitor": [
				{
					"id": "orchestratorMonitor.tasks",
					"name": "Tâches",
					"type": "webview",
					"icon": "resources/hephaistos-icon.png",
					"contextualTitle": "Tâches Orchestrateur"
				}
			]
		},
		"commands": [
			{
				"command": "orchestratorMonitor.openPanel",
				"title": "Hephaistos : Ouvrir le panneau Orchestrateur",
				"icon": "$(layout-editor-right)"
			},
			{
				"command": "orchestratorMonitor.refresh",
				"title": "Hephaistos : Actualiser les données",
				"icon": "$(sync)"
			},
			{
				"command": "orchestratorMonitor.startBridge",
				"title": "Hephaistos : Démarrer le bridge",
				"icon": "$(plug)"
			},
			{
				"command": "orchestratorMonitor.restartBridge",
				"title": "Hephaistos : Redémarrer le bridge",
				"icon": "$(debug-restart)"
			},
			{
				"command": "orchestratorMonitor.clearCompleted",
				"title": "Hephaistos : Purger les tâches terminées",
				"icon": "$(check-all)"
			},
			{
				"command": "orchestratorMonitor.clearFailed",
				"title": "Hephaistos : Purger les tâches échouées",
				"icon": "$(error)"
			},
			{
				"command": "orchestratorMonitor.clearPending",
				"title": "Hephaistos : Purger les tâches en attente",
				"icon": "$(watch)"
			},
			{
				"command": "orchestratorMonitor.sendToChat",
				"title": "Hephaistos : Envoyer du texte au chat Devin",
				"icon": "$(send)"
			}
		],
		"menus": {},
		"configuration": {
			"title": "Hephaistos Orchestrator Monitor",
			"properties": {
				"orchestratorMonitor.autoWake": {
					"type": "boolean",
					"default": true,
					"description": "Injecte un message de réveil dans le chat Devin quand une tâche orchestrée passe en completed/failed — uniquement si la tâche porte un tag [cascade:<id>] ou [agycascade:<id>] (sans tag : feed monitor + bus comms seulement, jamais la conversation active)."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^18.15.0",
		"@types/vscode": "^1.85.0",
		"@types/ws": "^8.18.2",
		"eslint": "^8.0.0",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"ws": "^8.0.0"
	},
	"galleryBanner": {
		"color": "#1a1d21",
		"theme": "dark"
	},
	"__metadata": {
		"installedTimestamp": 1791829482286,
		"targetPlatform": "undefined",
		"size": 14195789
	}
}