{
  "name": "hephaistos-chats",
  "displayName": "Hephaistos Chats",
  "description": "Onglets de chat Hephaistos + espace de travail React Flow : orchestration manuelle des agents du roster (roles, skills, missions, chaines de travail).",
  "version": "0.3.47",
  "icon": "media/icon.png",
  "publisher": "hephaistos",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hephaistosChats",
          "title": "Hephaistos Chats",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "hephaistosChats": [
        {
          "id": "hephaistosChats.list",
          "name": "Chats",
          "type": "webview",
          "icon": "media/icon.png",
          "contextualTitle": "Hephaistos Chats",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "hephaistosChats.newChat",
        "title": "Hephaistos : Nouveau chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hephaistosChats.openChat",
        "title": "Hephaistos : Ouvrir le chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hephaistosChats.openWorkspace",
        "title": "Hephaistos : Ouvrir lÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢espace de travail",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "hephaistosChats.openComfyUI",
        "title": "Hephaistos : Studio ComfyUI",
        "icon": "$(device-camera)"
      }
    ],
    "keybindings": [
      {
        "command": "hephaistosChats.openChat",
        "key": "ctrl+alt+h"
      }
    ],
    "configuration": {
      "title": "Hephaistos Chats — Espace de travail",
      "properties": {
        "hephaistos.flow.smartRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Ignore les pushes de workflow structurellement identiques (anti-flicker, anti re-render global)."
        },
        "hephaistos.flow.preserveLocalProps": {
          "type": "boolean",
          "default": true,
          "description": "Preserve les props locales des noeuds/edges (selected, type, animated, iconTheme) lors des refresh serveur."
        },
        "hephaistos.flow.alwaysFitView": {
          "type": "boolean",
          "default": true,
          "description": "Recentre la vue generale (fitView) a chaque refresh du workflow, sauf pendant un drag de noeud."
        }
      }
    }
  },
  "scripts": {
    "build:workspace": "esbuild webview/workspace.tsx --bundle --format=iife --platform=browser --target=es2020 --outdir=out/webview --entry-names=workspace --minify",
    "compile": "npm run build:workspace && tsc -p ./ && tsc -p ./tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "watch:workspace": "esbuild webview/workspace.tsx --bundle --format=iife --platform=browser --target=es2020 --outdir=out/webview --entry-names=workspace --minify --watch=forever",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.0.0"
  }
}