# ===========================================
# Hephaistos2-Kit — variables d'environnement
# ===========================================
# Copier en .env et ajuster. Toutes optionnelles — les scripts
# détectent leurs propres chemins (repo = dossier du clone,
# install = %ProgramFiles%\servers\hephaistos2-kit par défaut).

# === MÉMOIRE GLOBALE (mode dual) ===
# Racine du stockage mémoire partagé (KG, caches, rapports).
# start-workspace.ps1 en fait une junction memory-database -> $AGENT_DB_ROOT/current_workspace
AGENT_DB_ROOT=<chemin-vers-vos-bases-memoire>/

# === RUNTIME HPHE (défauts = <install> = HPHE_INSTALL ou %ProgramFiles%\servers\hephaistos2-kit) ===
# HPHE_INSTALL=%ProgramFiles%\servers\hephaistos2-kit
# HPHE_CONTENT_DIR=<install>\data\content-index
# HPHE_VEC_DIR=<install>\migrated-vec
# HPHE_ORCH_DB=<install>\data\orchestrator.db
# HPHE_MEMORY_ROOT=<install>\data\agentmemory
# HPHE_PIPE=\\.\pipe\hphe-index

# === INGESTION (boucle hphe-rest) ===
# Racines explicitement ingérées (';' séparé) — défaut : la racine du repo
# HPHE_INGEST_ROOTS=<chemin-vers-le-repo>
# Parents scannés pour marqueur .agent/ (découverte auto de workspaces)
# HPHE_INGEST_SCAN=<dossier-parent-de-vos-workspaces>
# HPHE_INGEST_INTERVAL_S=900

# === CLÉS API ===
# NVIDIA_API_KEY et MISTRAL_API_KEY : variables d'environnement
# utilisateur (HKCU) — ne JAMAIS les mettre dans .env commité.
