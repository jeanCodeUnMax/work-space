{
  "name": "everything-search",
  "displayName": "Everything Search",
  "description": "Instant NTFS file search & browser powered by Everything.exe's live index (IPC) — Sherlock finds it before you finish typing",
  "version": "1.0.1",
  "publisher": "art-qalam",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/projet-temporaire/everything-mcp.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "everything-search.openSearch",
        "title": "Everything: Open Search",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "everything-search",
          "title": "Everything Search",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "everything-search": [
        {
          "type": "webview",
          "id": "everything-search.searchView",
          "name": "Search",
          "contextualTitle": "Everything",
          "icon": "media/icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "everything-search.openSearch",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "Everything Search",
      "properties": {
        "everythingSearch.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the everything-search MCP server script. Leave empty to use the server bundled in the extension."
        },
        "everythingSearch.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to spawn the MCP server. Leave empty to auto-detect (python, python3, py)."
        },
        "everythingSearch.maxResults": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "description": "max_results sent to everything_search per query"
        },
        "everythingSearch.renderCap": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "Max rows rendered in the webview (rest are truncated with a note)"
        },
        "everythingSearch.requestTimeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "description": "Per-request timeout for MCP calls"
        }
      }
    }
  }
}
